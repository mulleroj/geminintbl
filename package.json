{
  "name": "notebook-hub-cz",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "typecheck": "tsc --noEmit",
    "lint": "node scripts/lint.mjs",
    "content:audit": "node scripts/content-audit.mjs",
    "guides:check": "node scripts/guides-audit.mjs",
    "sources:quality": "node scripts/source-quality-v1.mjs",
    "sources:check": "node scripts/check-sources.mjs",
    "naming:audit": "node scripts/naming-audit.mjs",
    "tools:check": "node scripts/check-catalog-links.mjs tools",
    "slide-editor:perf": "node tests/slide-editor-performance.mjs",
    "notebooks:check": "node scripts/check-catalog-links.mjs notebooks",
    "prompt:quality": "node scripts/prompt-quality-audit.mjs",
    "prompt:coverage": "node scripts/prompt-coverage-audit.mjs",
    "test": "node --test tests/*.test.mjs"
  },
  "devDependencies": {
    "jszip": "^3.10.1",
    "typescript": "^5.7.2",
    "vite": "^6.0.7"
  },
  "dependencies": {
    "pdfjs-dist": "^6.2.108",
    "pptxgenjs": "^4.0.1",
    "tesseract.js": "^7.0.0"
